# Rendered to /etc/derp-guard/config.toml (mode 0600) by deploy_derp.py.
# Variables come from the host's host.data.derp / host.data.guard in inventory.py.

[derper]
bin_path    = "/usr/libexec/derper"
hostname    = "{{ derp.hostname }}"
listen_addr = "{{ derp.listen_addr }}"
http_port   = {{ derp.http_port }}
stun_port   = {{ derp.stun_port }}
home        = "{{ derp.home }}"
cert_dir    = "/var/lib/derp-guard/certs"
ipv4        = "{{ derp.ipv4 }}"
extra_flags = []

cert_mode               = "{{ derp.cert_mode }}"
cert_file               = "{{ derp.cert_file }}"
key_file                = "{{ derp.key_file }}"
cert_check_interval_sec = 60

[guard]
poll_interval_sec  = {{ guard.poll_interval_sec }}
miss_cooldown_sec  = {{ guard.miss_cooldown_sec }}
revoke_on_auth_err = {{ guard.revoke_on_auth_err | lower }}
status_listen      = "{{ guard.status_listen }}"
cache_file         = "/var/lib/derp-guard/nodes_cache.json"

{% if guard.static_nodes %}
[guard.static_nodes]
{% for key, note in guard.static_nodes.items() %}
"{{ key }}" = "{{ note }}"
{% endfor %}
{% endif %}

{% for f in guard.friends %}
[[guard.friends]]
name          = "{{ f.name }}"
client_id     = "{{ f.client_id }}"
client_secret = "{{ f.client_secret }}"

{% endfor %}
